{
  "manifest_version": 3,
  "name": "Nellis Enhanced",
  "version": "2026.5.23",
  "description": "Nellis enhanced browser extension",
  "permissions": [],
  "host_permissions": [
    "https://www.nellisauction.com/*",
    "https://nellisauction.com/*",
    "https://www.amazon.com/*"
  ],
  "background": {
    "service_worker": "background.bundle.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.nellisauction.com/*",
        "https://nellisauction.com/*"
      ],
      "js": ["pageWorldFetchBridge.bundle.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.nellisauction.com/*",
        "https://nellisauction.com/*"
      ],
      "js": ["contentScript.bundle.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
